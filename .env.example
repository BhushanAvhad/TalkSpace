# ==============================================================================
# TalkSpace Backend Environment Variables (Production & Development)
# ==============================================================================

# Server Listening Port (Render assigns this automatically via process.env.PORT)
PORT=3000
NODE_ENV=production

# Supabase Configuration
# Replace these with your project credentials from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Supabase Storage Bucket for Uploaded Attachments & Media
# Create a bucket named "talkspace-files" in Supabase Storage dashboard
SUPABASE_STORAGE_BUCKET=talkspace-files

# Retention Policy (Hours)
# Public #general messages & attachments are automatically purged after this interval
PUBLIC_GROUP_RETENTION_HOURS=48

# Frontend Application Origin (Vercel deployment URL)
# Used for CORS validation and Socket.IO handshake authorization
FRONTEND_URL=https://your-app-name.vercel.app
CLIENT_URL=https://your-app-name.vercel.app

# Optional Comma-Separated Allowed Origins (e.g. custom domain + preview domains)
# CORS_ORIGIN=https://talkspace.vercel.app,https://talkspace.com
