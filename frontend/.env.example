# ==============================================================================
# TalkSpace Frontend Environment Variables (Vite / Vercel)
# ==============================================================================

# Backend API Endpoint (e.g. deployed Render URL)
# In local development, leave blank to use the local Vite development proxy.
# On Vercel, set to your Render backend URL (e.g. https://talkspace-backend.onrender.com)
VITE_API_URL=https://talkspace-backend.onrender.com

# Backend Socket.IO Server Endpoint
# In local development, leave blank to connect to the current origin / Vite proxy.
# On Vercel, set to your Render backend URL (e.g. https://talkspace-backend.onrender.com)
VITE_SOCKET_URL=https://talkspace-backend.onrender.com

